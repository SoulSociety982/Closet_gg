local Exploit, ExploitVersion = "Unknown", nil
if identifyexecutor then
    local ok, name, ver = pcall(identifyexecutor)
    if ok and type(name) == "string" then
        Exploit = name
        ExploitVersion = ver
    end
end

local ExploitLower = string.lower(tostring(Exploit))

local Unsupported_Executors = {
    ["xeno"] = true,
    ["solara"] = true,
}

if Unsupported_Executors[ExploitLower] then
    local msg = ("Unsupported executor detected: %s. Please use a supported executor."):format(Exploit)

    pcall(function()
        if game.Players and game.Players.LocalPlayer then
            game.Players.LocalPlayer:Kick(msg)
        end
    end)

    warn(msg)
    return
end

local Bladeball = {
    [13772394625] = true,
    [15234596844] = true,
    [15144787112] = true,
    [14732610803] = true,
    [15264892126] = true,
    [15131065025] = true,
}

local Flick = {
    [136801880565837] = true,
}

local Untitled_Tag_Game = {
    [14044547200] = true,
    [18333958402] = true,
    [17588217277] = true,
}

local url
if Bladeball[game.PlaceId] then
    url = "https://api.polsec.net/loader/6750e025902df237/e47868cd7e6110a6"
elseif Flick[game.PlaceId] then
    url = "https://api.polsec.net/loader/6750e025902df237/4684f06f001e6b58"
elseif Untitled_Tag_Game[game.PlaceId] then
    url = "https://api.polsec.net/loader/6750e025902df237/ba97d7392ae41b50"
end

if not url then
    warn(("Unsupported game (PlaceId: %d). No script available."):format(game.PlaceId))
    return
end

local ok, sourceOrErr = pcall(function()
    return game:HttpGet(url)
end)
if not ok or type(sourceOrErr) ~= "string" then
    warn("Failed to download script: " .. tostring(sourceOrErr))
    return
end

local chunk, compileErr = loadstring(sourceOrErr)
if not chunk then
    warn("Failed to compile script: " .. tostring(compileErr))
    return
end

local runOk, runErr = pcall(chunk)
if not runOk then
    warn("Script runtime error: " .. tostring(runErr))
end
